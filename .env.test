# Test environment variables
# All ports are shifted by +30000 to avoid conflicts with production services

# PostgreSQL 18 with TimescaleDB - port 35432
TEST_DB_HOST=localhost
TEST_DB_PORT=35432
TEST_DB_NAME=lamb_test
TEST_DB_USER=lamb_test
TEST_DB_PASSWORD=lamb_test_pass

# Valkey Standalone - port 36379
TEST_VALKEY_HOST=localhost
TEST_VALKEY_PORT=36379
TEST_VALKEY_DB=0
TEST_VALKEY_PASSWORD=testpass123

# Valkey Sentinel - port 36380 (master), 36382 (sentinel)
TEST_VALKEY_SENTINEL_HOST=localhost
TEST_VALKEY_SENTINEL_PORT=36380
TEST_VALKEY_SENTINEL_MASTER_PORT=36380
TEST_VALKEY_SENTINEL_REPLICA_PORT=36381
TEST_VALKEY_SENTINEL_MASTER_NAME=mymaster
TEST_VALKEY_SENTINEL_PASSWORD=testpass123

# Valkey Cluster - ports 36390-36392
TEST_VALKEY_CLUSTER_HOSTS=localhost:36390,localhost:36391,localhost:36392
TEST_VALKEY_CLUSTER_PASSWORD=testpass123

# MinIO - ports 39000 (API), 39001 (Console)
TEST_S3_ENDPOINT=http://localhost:39000
TEST_S3_ACCESS_KEY=minio
TEST_S3_SECRET_KEY=minio123
TEST_S3_REGION=us-east-1
TEST_S3_BUCKET=test-bucket

# Kafka 3.9 - port 39092
TEST_KAFKA_BOOTSTRAP_SERVERS_1=localhost:39092
TEST_KAFKA_BOOTSTRAP_SERVERS_2=localhost:39093
TEST_KAFKA_BOOTSTRAP_SERVERS=localhost:39092,localhost:39093

# Test execution
TEST_PARALLEL=false
TEST_COVERAGE=true
